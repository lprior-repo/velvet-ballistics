                  },
                  {
                    "file": "Cargo.lock"
                  },
                  {
                    "file": "rust-toolchain.toml"
                  },
                  {
                    "file": ".evidence/kani-list/vb_core.json"
                  },
                  {
                    "file": ".evidence/kani-list/vb_validate.json"
                  },
                  {
                    "file": ".evidence/kani/baseline/README.md"
                  },
                  {
                    "file": ".evidence/kani/baseline/baseline-harnesses.json"
                  },
                  {
                    "file": ".moon/tasks/kani.yml"
                  }
                ],
                "outputs": [
                  {
                    "file": ".evidence/kani/baseline/vb_core.log"
                  },
                  {
                    "file": ".evidence/kani/baseline/vb_validate.log"
                  }
                ],
                "options": {
                  "cache": false,
                  "runInCi": true,
                  "runInSyncPhase": null
                },
                "script": "set -euo pipefail\nmkdir -p target/kani-tmp target/moon-locks .evidence/kani/baseline\nflock --shared target/moon-locks/source-mutation.lock \\\n  env -u RUSTC_WRAPPER \\\n      TMPDIR=\"$PWD/target/kani-tmp\" \\\n      RUSTFLAGS=\"-Dwarnings\" \\\n      CARGO_TARGET_DIR=target/kani-baseline-heavy-vb-core \\\n  timeout 90m rustup run nightly-2026-04-28 \\\n    cargo kani --lib -p vb_core --all-features -j 1 \\\n      --harness 'kani_idempotency_gates::verify_idempotency_symbolic_key_taints_are_classified' \\\n      --harness 'kani_idempotency_gates::validate_action_outcome_symbolic_completion_matrix' \\\n      --harness 'kani_idempotency_gates::verify_idempotency_retry_policy_matrix_is_total' \\\n    2>&1 | tee .evidence/kani/baseline/vb_core_heavy.log \\\n  || { cat .evidence/kani/baseline/vb_core_heavy.log >&2; exit 1; }\nif ! grep -q 'VERIFICATION:- SUCCESSFUL' .evidence/kani/baseline/vb_core_heavy.log; then\n  printf 'kani-baseline-heavy: missing VERIFICATION:- SUCCESSFUL\\n' >&2\n  exit 1\nfi\n",
                "toolchains": [
                  "rust"
                ]
              },
              "verify-kani": {
                "command": null,
                "args": null,
                "globalInputs": [
                  {
                    "file": "/.moon/tasks/kani.yml"
                  }
                ],
                "inputs": [
                  "@globs(kani_sources)",
                  "@globs(kani_harnesses)",
                  {
                    "file": "Cargo.toml"
                  },
                  {
                    "file": "rust-toolchain.toml"
                  }
                ],
                "options": {
                  "cache": false,
                  "runInCi": true,
                  "runInSyncPhase": null
                },
                "script": "set -euo pipefail\nmkdir -p target/kani-tmp\nmkdir -p target/moon-locks\n# Multi-harness invocation: cargo-kani accepts multiple --harness\n# flags (per the cargo-kani 0.x help), so the CBMC pipeline spins\n# up once and the dep-graph fingerprint is paid only once. Sharing\n# CARGO_TARGET_DIR with the validate task keeps the CBMC side\n# artifacts warm across tasks.\nTMPDIR=\"$PWD/target/kani-tmp\" flock --shared target/moon-locks/source-mutation.lock env -u RUSTC_WRAPPER CARGO_TARGET_DIR=target/kani-vb-core RUSTFLAGS=\"-Dwarnings\" timeout 25m rustup run nightly-2026-04-28 cargo kani --lib -p vb_core --all-features --quiet --harness kani_budget_add_dim_zero --harness kani_budget_sub_dim_zero --harness kani_aggregate_usage_zero --harness kani_try_add_budget_zero_current\n",
                "toolchains": [
                  "rust"
                ]
              },
              "verify-kani-vb-validate": {
                "command": null,
                "args": null,
                "globalInputs": [
                  {
                    "file": "/.moon/tasks/kani.yml"
                  }
                ],
                "inputs": [
                  "@globs(kani_sources)",
                  "@globs(kani_harnesses)",
                  {
                    "file": "Cargo.toml"
                  },
                  {
                    "file": "rust-toolchain.toml"
                  }
                ],
                "options": {
                  "cache": false,
                  "runInCi": true,
                  "runInSyncPhase": null
                },
                "script": "set -euo pipefail\nmkdir -p target/kani-tmp\nmkdir -p target/moon-locks\n# Multiple --harness flags run in one cargo kani invocation: the\n# CBMC pipeline spins up once and the dep-graph fingerprint is\n# paid only once. Previous per-harness calls cost ~9m for the\n# validate crate; this form completes in seconds when the\n# fingerprint and goto binaries are warm.\nTMPDIR=\"$PWD/target/kani-tmp\" flock --shared target/moon-locks/source-mutation.lock env -u RUSTC_WRAPPER CARGO_TARGET_DIR=target/kani-vb-validate RUSTFLAGS=\"-Dwarnings\" timeout 25m rustup run nightly-2026-04-28 cargo kani -p vb_validate --all-features --quiet --harness kani_gate_08_valid_zero_accessors_pass --harness kani_gate_08_arbitrary_parts_valid_accessors_pass --harness kani_gate_08_arbitrary_parts_root_oob_rejected --harness kani_gate_08_arbitrary_parts_symbol_oob_rejected\n",
                "toolchains": [
                  "rust"
                ]
              }
            }
          },
