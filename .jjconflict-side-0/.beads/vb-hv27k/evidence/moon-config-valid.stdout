          "script": "set -euo pipefail\nmkdir -p target/tlc-tmp\nmkdir -p target/moon-locks\nif command -v tlc >/dev/null 2>&1; then\n  TLC=(tlc)\nelif [ -n \"${TLA2TOOLS_JAR:-}\" ] && [ -f \"$TLA2TOOLS_JAR\" ]; then\n  TLC=(java -jar \"$TLA2TOOLS_JAR\")\nelse\n  echo \"Missing TLC runner: install a tlc wrapper or set TLA2TOOLS_JAR to an existing tla2tools.jar\" >&2\n  exit 127\nfi\n# Run the fail-closed CI baseline root models. Heavier exploratory specs stay\n# outside this CI task until they have bounded, time-safe configs.\nfor spec in \\\n  verification/tla/WorkflowBoundedAdmission.tla \\\n  verification/tla/IdempotencySafety.tla\ndo\n  cfg=\"${spec%.tla}.cfg\"\n  if [ ! -f \"$spec\" ]; then\n    echo \"Missing TLC spec: $spec\" >&2\n    exit 1\n  fi\n  if [ ! -f \"$cfg\" ]; then\n    echo \"Missing TLC config for $spec: $cfg\" >&2\n    exit 1\n  fi\n  model_name=\"${spec##*/}\"\n  model_name=\"${model_name%.tla}\"\n  meta_dir=\"$PWD/target/tlc-tmp/verify-tlc-${model_name}-$$\"\n  rm -rf \"$meta_dir\"\n  mkdir -p \"$meta_dir\"\n  echo \"Checking TLC model: $spec\"\n  TMPDIR=\"$PWD/target/tlc-tmp\" flock --exclusive target/moon-locks/tlc-runner.lock \\\n    \"${TLC[@]}\" -terse -metadir \"$meta_dir\" -config \"$cfg\" \"$spec\"\ndone\n",
          "state": {
            "expanded": true,
            "rootLevel": true,
            "setRunInCi": true
          },
