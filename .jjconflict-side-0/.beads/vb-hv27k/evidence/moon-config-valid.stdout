              "optional": false
            }
          },
          "script": "set -euo pipefail\nif ! command -v rg >/dev/null 2>&1; then\n  printf 'Missing required scanner: rg\\n' >&2\n  exit 127\nfi\nmkdir -p target/static-audit\nunsafe_pattern='(^|[^A-Za-z0-9_])unsafe[[:space:]]*(\\{|fn\\b|trait\\b|impl\\b|extern\\b|\\()'\nlog_file='target/static-audit/unsafe-audit.log'\nif rg -n \"$unsafe_pattern\" crates --glob '*.rs' --glob '!**/tests/**' --glob '!**/benches/**' --glob '!**/examples/**' --glob '!**/fixtures/**' --glob '!**/verification/**' --glob '!**/kani*/**' >\"$log_file\"; then\n  cat \"$log_file\" >&2\n  printf 'Forbidden first-party unsafe construct found.\\n' >&2\n  exit 1\nelse\n  rg_status=\"$?\"\n  if [ \"$rg_status\" -eq 1 ]; then\n    :\n  else\n    cat \"$log_file\" >&2\n    printf 'Unsafe audit scan failed with rg status %s.\\n' \"$rg_status\" >&2\n    exit \"$rg_status\"\n  fi\nfi\n",
          "state": {
            "expanded": true,
            "rootLevel": true,
            "setRunInCi": true
          },
          "target": "velvet-ballistics:unsafe-audit",
