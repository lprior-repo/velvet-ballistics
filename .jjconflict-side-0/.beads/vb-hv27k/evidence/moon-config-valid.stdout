          "script": "set -euo pipefail\nmkdir -p target/kani-tmp target/moon-locks .evidence/kani/baseline\n# Light vb_core harnesses only (heavy idempotency harnesses run in\n# kani-baseline-heavy to avoid CBMC OOM from cumulative memory).\nflock --shared target/moon-locks/source-mutation.lock \\\n  env -u RUSTC_WRAPPER \\\n      TMPDIR=\"$PWD/target/kani-tmp\" \\\n      RUSTFLAGS=\"-Dwarnings\" \\\n      CARGO_TARGET_DIR=target/kani-baseline-vb-core \\\n  timeout 60m rustup run nightly-2026-04-28 \\\n    cargo kani --lib -p vb_core --all-features -j 1 \\\n      --harness 'kani_step_budget_try_take_arbitrary::kani_step_budget_try_take_arbitrary' \\\n      --harness 'kani_idempotency_gates::kani_verify_idempotency_missing_key' \\\n      --harness 'kani_idempotency_gates::kani_action_ticket_has_valid_key' \\\n      --harness 'kani_idempotency_gates::validate_action_outcome_certificate_stale_nonterminal' \\\n      --harness 'kani_idempotency_gates::validate_action_outcome_certificate_rejects_undeclared_output' \\\n      --harness 'kani_idempotency_gates::idempotency_divergent_digest_symbolic_certificate_rejected' \\\n      --harness 'kani_idempotency_gates::verify_idempotency_retry_policy_matrix_no_frame_write' \\\n      --harness 'kani_idempotency_gates::verify_idempotency_frame_slot_bounds_no_panic' \\\n      --harness 'kani_idempotency_gates::verify_idempotency_boundary_key_lengths_pass_clean_frame' \\\n      --harness 'kani_idempotency_gates::verify_idempotency_duplicate_failure_tainted_key' \\\n      --harness 'kani_idempotency_gates::verify_idempotency_duplicate_success_clean_key' \\\n      --harness 'kani_idempotency_gates::verify_idempotency_duplicate_invocation_is_stable' \\\n      --harness 'kani_idempotency_gates::verify_idempotency_required_taint_variants_have_witnesses' \\\n      --harness 'kani_taint::' \\\n      --harness 'kani_workflow_budget_harnesses::' \\\n    2>&1 | tee .evidence/kani/baseline/vb_core.log \\\n  || { cat .evidence/kani/baseline/vb_core.log >&2; exit 1; }\nflock --shared target/moon-locks/source-mutation.lock \\\n  env -u RUSTC_WRAPPER \\\n      TMPDIR=\"$PWD/target/kani-tmp\" \\\n      RUSTFLAGS=\"-Dwarnings\" \\\n      CARGO_TARGET_DIR=target/kani-baseline-vb-validate \\\n  timeout 60m rustup run nightly-2026-04-28 \\\n    cargo kani --lib -p vb_validate --all-features -j 1 \\\n      --harness 'kani_gate_08_arbitrary_parts_valid_accessors_pass' \\\n      --harness 'kani_gate_08_arbitrary_parts_root_oob_rejected' \\\n      --harness 'kani_gate_08_arbitrary_parts_symbol_oob_rejected' \\\n      --harness 'kani_step_primitives::' \\\n    2>&1 | tee .evidence/kani/baseline/vb_validate.log \\\n  || { cat .evidence/kani/baseline/vb_validate.log >&2; exit 1; }\n# Fail-closed: every baseline package must emit the success sentinel.\n# cargo-kani emits \"VERIFICATION:- SUCCESSFUL\" once per harness on\n# success; the substring check proves we did not silently skip a\n# harness without an error code.\nfor pkg in vb_core vb_validate; do\n  log=\".evidence/kani/baseline/${pkg}.log\"\n  if ! grep -q 'VERIFICATION:- SUCCESSFUL' \"$log\"; then\n    printf 'kani-baseline: missing VERIFICATION:- SUCCESSFUL in %s\\n' \"$log\" >&2\n    exit 1\n  fi\ndone\n",
          "state": {
            "defaultInputs": true,
            "expanded": true,
            "rootLevel": true
          },
          "target": "velvet-ballistics:kani-baseline",
          "toolchains": [
            "rust"
