                },
                "script": "set -euo pipefail\nexport PATH=\"/cache/cargo-shared/bin:${PATH}\"\nmkdir -p target/moon-locks target/fuzz-regress\nif ! flock --shared target/moon-locks/source-mutation.lock env RUSTFLAGS=\"-Dwarnings\" rustup run nightly-2026-04-28 cargo fuzz build --target x86_64-unknown-linux-gnu --target-dir \"$PWD/target/fuzz-asan/build\" >target/fuzz-regress/build.log 2>target/fuzz-regress/build.err; then\n  cat target/fuzz-regress/build.log\n  cat target/fuzz-regress/build.err\n  exit 1\nfi\nrc=0\nwhile IFS= read -r artifact; do\n  tgt=$(basename \"$(dirname \"$artifact\")\")\n  bin=\"target/fuzz-asan/build/x86_64-unknown-linux-gnu/release/${tgt}\"\n  if [ ! -x \"$bin\" ]; then\n    echo \"MISSING: $tgt (binary required for $artifact)\"\n    rc=1\n    continue\n  fi\n  echo \"REPLAY: $artifact via $tgt\"\n  if timeout 5s \"$bin\" \"$artifact\" >\"target/fuzz-regress/${tgt}.log\" 2>&1; then\n    echo \"PASS: $artifact\"\n  else\n    echo \"REGRESSION: $artifact\"\n    cat \"target/fuzz-regress/${tgt}.log\"\n    rc=1\n  fi\ndone < <(find fuzz/artifacts -type f \\( -name 'crash-*' -o -name 'oom-*' -o -name 'leak-*' -o -name 'timeout-*' \\) 2>/dev/null || true)\nexit \"$rc\"\n"
              },
