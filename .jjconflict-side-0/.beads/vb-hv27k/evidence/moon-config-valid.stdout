        "verify-kani": {
          "command": "set",
          "id": "verify-kani",
          "inputs": [
            "@globs(kani_sources)",
            "@globs(kani_harnesses)",
            {
              "file": "Cargo.toml"
            },
            {
              "file": "rust-toolchain.toml"
            },
            {
              "glob": "/.moon/*.{yml,yaml,jsonc,json,pkl,hcl,toml}",
              "cache": true
            },
            {
              "file": "/.moon/tasks/kani.yml"
            }
          ],
          "inputFiles": {
            "Cargo.toml": {},
            ".moon/tasks/kani.yml": {},
            "rust-toolchain.toml": {}
          },
          "inputGlobs": {
            "verification/kani/**/*.rs": {
              "cache": true
            },
            "crates/vb_validate/src/**/*": {
              "cache": true
            },
            ".moon/*.{yml,yaml,jsonc,json,pkl,hcl,toml}": {
              "cache": true
            },
            "crates/vb_core/src/**/*": {
              "cache": true
            },
            "verification/kani/**/*": {
              "cache": true
            }
          },
          "options": {
            "allowFailure": false,
            "cache": false,
            "inferInputs": false,
            "internal": false,
            "interactive": false,
            "mergeArgs": "append",
            "mergeDeps": "append",
            "mergeEnv": "append",
            "mergeInputs": "append",
            "mergeOutputs": "append",
            "mergeToolchains": "append",
            "persistent": false,
            "priority": "normal",
            "retryCount": 0,
            "runDepsInParallel": true,
            "runInCI": true,
            "runInSyncPhase": false,
            "runFromWorkspaceRoot": false,
            "shell": true,
            "unixShell": "bash",
            "windowsShell": "powershell"
          },
          "script": "set -euo pipefail\nmkdir -p target/kani-tmp\nmkdir -p target/moon-locks\n# Multi-harness invocation: cargo-kani accepts multiple --harness\n# flags (per the cargo-kani 0.x help), so the CBMC pipeline spins\n# up once and the dep-graph fingerprint is paid only once. Sharing\n# CARGO_TARGET_DIR with the validate task keeps the CBMC side\n# artifacts warm across tasks.\nTMPDIR=\"$PWD/target/kani-tmp\" flock --shared target/moon-locks/source-mutation.lock env -u RUSTC_WRAPPER CARGO_TARGET_DIR=target/kani-vb-core RUSTFLAGS=\"-Dwarnings\" timeout 25m rustup run nightly-2026-04-28 cargo kani --lib -p vb_core --all-features --quiet --harness kani_budget_add_dim_zero --harness kani_budget_sub_dim_zero --harness kani_aggregate_usage_zero --harness kani_try_add_budget_zero_current\n",
          "state": {
            "expanded": true,
            "rootLevel": true,
            "setRunInCi": true
          },
          "target": "velvet-ballistics:verify-kani",
          "toolchains": [
            "rust"
          ],
          "type": "test"
        },
        "verify-kani-vb-validate": {
          "command": "set",
          "id": "verify-kani-vb-validate",
          "inputs": [
            "@globs(kani_sources)",
            "@globs(kani_harnesses)",
            {
              "file": "Cargo.toml"
            },
            {
              "file": "rust-toolchain.toml"
            },
            {
              "glob": "/.moon/*.{yml,yaml,jsonc,json,pkl,hcl,toml}",
              "cache": true
            },
            {
