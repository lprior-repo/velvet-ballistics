                "options": {
                  "runInCi": true,
                  "runInSyncPhase": null
                },
                "script": "set -euo pipefail\nexport PATH=\"/cache/cargo-shared/bin:${PATH}\"\nmkdir -p target/moon-locks\nmkdir -p target/fuzz-smoke\nif ! flock --shared target/moon-locks/source-mutation.lock env RUSTFLAGS=\"-Dwarnings\" rustup run nightly-2026-04-28 cargo fuzz build --target x86_64-unknown-linux-gnu --target-dir \"$PWD/target/fuzz-asan/build\" >target/fuzz-smoke/build.log 2>target/fuzz-smoke/build.err; then\n  cat target/fuzz-smoke/build.log\n  cat target/fuzz-smoke/build.err\n  exit 1\nfi\nmapfile -t fuzz_targets < <(cargo fuzz list)\nif [ \"${#fuzz_targets[@]}\" -eq 0 ]; then\n  echo \"cargo fuzz list returned no targets\" >&2\n  exit 1\nfi\nbin_dir=\"target/fuzz-asan/build/x86_64-unknown-linux-gnu/release\"\nfor fuzz_target in \"${fuzz_targets[@]}\"; do\n  bin=\"${bin_dir}/${fuzz_target}\"\n  {\n    echo \"=== compile evidence: ${fuzz_target} ===\"\n    if [ -x \"${bin}\" ]; then\n      ls -la \"${bin}\"\n      echo \"OK: binary present\"\n    else\n      echo \"MISSING: ${bin}\"\n      exit 1\n    fi\n  } >\"target/fuzz-smoke/${fuzz_target}.compile.log\" 2>&1\n  corpus=\"target/fuzz-smoke/corpus/${fuzz_target}\"\n  artifacts=\"target/fuzz-smoke/artifacts/${fuzz_target}\"\n  rm -rf \"${corpus}\" \"${artifacts}\"\n  mkdir -p \"${corpus}\" \"${artifacts}\"\n  if [ -d \"fuzz/corpus/${fuzz_target}\" ]; then\n    cp -R \"fuzz/corpus/${fuzz_target}/.\" \"${corpus}/\"\n  fi\n  flock --shared target/moon-locks/source-mutation.lock timeout 30s \"${bin}\" -artifact_prefix=\"${PWD}/${artifacts}/\" -max_total_time=1 \"${PWD}/${corpus}\" >\"target/fuzz-smoke/${fuzz_target}.log\" 2>\"target/fuzz-smoke/${fuzz_target}.err\"\ndone\n",
                "toolchains": [
                  "rust"
                ]
              },
