          "script": "set -euo pipefail\nmkdir -p target/moon-locks\nmkdir -p target/tmp\n# Smoke policy: prove cargo-mutants integration on a bounded, deterministic\n# vb_core slice without mutating the source tree in place. Full mutation-score\n# debt is tracked separately.\nflock --shared target/moon-locks/source-mutation.lock env TMPDIR=\"$PWD/target/tmp\" RUSTC_WRAPPER= timeout 10m rustup run nightly-2026-04-28 cargo mutants \\\n  --package vb_core \\\n  --file crates/vb_core/src/diagnostic.rs \\\n  --re 'is_supported_code -> bool with false' \\\n  --baseline skip \\\n  --jobs 1 \\\n  --gitignore true \\\n  --no-shuffle \\\n  --no-times \\\n  --timeout 60 \\\n  --minimum-test-timeout 2 \\\n  --output target/mutants-smoke \\\n  -- --lib diagnostic::\n",
