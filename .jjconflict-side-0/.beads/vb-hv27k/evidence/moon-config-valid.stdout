                    "file": "Cargo.toml"
                  },
                  {
                    "file": "Cargo.lock"
                  },
                  {
                    "file": "rust-toolchain.toml"
                  },
                  {
                    "file": "fuzz/Cargo.toml"
                  },
                  {
                    "file": "fuzz/Cargo.lock"
                  },
                  {
                    "file": "fuzz/fuzz_targets.rs"
                  },
                  {
                    "glob": "fuzz/fuzz_targets/**/*",
                    "cache": true
                  },
                  {
                    "glob": "fuzz/src/**/*",
                    "cache": true
                  },
                  {
                    "glob": "crates/vb_core/**/*",
                    "cache": true
                  },
                  {
                    "glob": "crates/vb_compile/**/*",
                    "cache": true
                  },
                  {
                    "glob": "crates/vb_ipc/**/*",
                    "cache": true
                  },
                  {
