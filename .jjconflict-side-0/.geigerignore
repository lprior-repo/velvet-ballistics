# .geigerignore — False positive ignores for cargo-geiger
#
# cargo-geiger reports unsafe code usage in the dependency tree.
# This file lists third-party crates that produce false positives
# (e.g., internal unsafe usage for performance that is safe in context).

# Build artifacts
target/

# Fuzzing corpora and targets
.fuzz/
fuzz/

# Third-party crates in the Cargo registry — these use unsafe internally
# but are well-audited and the unsafe is an implementation detail.
# We explicitly ignore each third-party crate by registry path.

# fjall uses unsafe for SIMD optimizations and memory alignment
$CRATE_HOME/registry/src/*/fjall-*/

# saphyr and saphyr-parser use unsafe for YAML parsing performance
$CRATE_HOME/registry/src/*/saphyr-*/
$CRATE_HOME/registry/src/*/saphyr-parser-*/

# bytes uses unsafe for zero-copy slice operations
$CRATE_HOME/registry/src/*/bytes-*/

# blake3 uses unsafe for SIMD implementation
$CRATE_HOME/registry/src/*/blake3-*/

# crossbeam-queue uses unsafe for lock-free algorithms
$CRATE_HOME/registry/src/*/crossbeam-queue-*/

# rtrb uses unsafe for lock-free ring buffer
$CRATE_HOME/registry/src/*/rtrb-*/

# arrayvec uses unsafe for inline array operations
$CRATE_HOME/registry/src/*/arrayvec-*/

# tempfile uses unsafe for file descriptor handling
$CRATE_HOME/registry/src/*/tempfile-*/

# postcard uses unsafe for efficient serialization
$CRATE_HOME/registry/src/*/postcard-*/

# thiserror is pure safe code but may transitively depend on unsafe crates
$CRATE_HOME/registry/src/*/thiserror-*/
