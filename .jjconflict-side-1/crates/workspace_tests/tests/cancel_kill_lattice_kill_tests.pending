/// B24: kill live run appends exactly one RunKilled event.
#[test]
fn kill_live_run_appends_exactly_one_runkilled_event() -> Result<(), String> {
    let journal = Arc::new(VolatileRuntimeJournal::new());
    let mut runtime = Runtime::new_with_journal(shard_count(1)?, test_config(), journal.clone());
    let run = RunId::new(50001);

