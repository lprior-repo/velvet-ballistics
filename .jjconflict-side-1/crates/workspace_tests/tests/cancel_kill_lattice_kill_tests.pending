// =============================================================================
// C1: Public Kill API (B01-B06)
// NOTE: kill_run does not exist yet on Runtime (State 10).
// These tests will FAIL to compile until kill_run is implemented.
// =============================================================================

/// B01: kill_run enqueues ShardCommand::Kill and after tick produces RunKilled journal event.
#[test]
fn kill_run_enqueues_shard_command_when_run_routes_to_shard() -> Result<(), String> {
    let journal = Arc::new(VolatileRuntimeJournal::new());
    let mut runtime = Runtime::new_with_journal(shard_count(1)?, test_config(), journal.clone());
    let run = RunId::new(30001);

    assert_eq!(
        submit_action_then_finish(&runtime, run, action_then_finish_workflow()?),
        Ok(())
    );
    tick_count(&mut runtime, 2)?;

    let counters_before = runtime.counters_snapshot();
    assert_eq!(counters_before.runs_completed, 0);

    // TDD RED: kill_run does not exist yet — will fail to compile
    assert_eq!(runtime.kill_run(run), Ok(()));
    tick_and_drain(&mut runtime)?;

    let counters = runtime.counters_snapshot();
    assert_eq!(counters.runs_failed, 1, "killed run counts as failed");

    let events = journal
        .snapshot()
        .map_err(|e| format!("journal snapshot failed: {e:?}"))?;
    assert!(
        events.iter().any(|e| matches!(
            e,
            RuntimeJournalEvent::RunKilled { run: r } if *r == run
        )),
        "journal must contain RunKilled event after kill"
    );

    Ok(())
}

/// B05: kill_run on already-completed run produces no side effects.
#[test]
fn kill_run_on_completed_run_has_no_side_effects() -> Result<(), String> {
    let journal = Arc::new(VolatileRuntimeJournal::new());
    let mut runtime = Runtime::new_with_journal(shard_count(1)?, test_config(), journal.clone());
    let run = RunId::new(30002);

    assert_eq!(runtime.submit_direct(run, finished_workflow()?), Ok(()));
    tick_count(&mut runtime, 2)?;

    let counters_before = runtime.counters_snapshot();
    assert_eq!(counters_before.runs_completed, 1);

    assert_eq!(runtime.kill_run(run), Ok(()));
    tick_and_drain(&mut runtime)?;

    let counters_after = runtime.counters_snapshot();
    assert_eq!(
        counters_before.runs_completed, counters_after.runs_completed,
        "completed counter unchanged after kill on completed run"
    );
    assert_eq!(
        counters_before.runs_failed, counters_after.runs_failed,
        "failed counter unchanged after kill on completed run"
    );

    Ok(())
}

/// B05-ext: kill_run on a cancelled run produces no side effects.
#[test]
fn kill_run_on_cancelled_run_produces_no_extra_events() -> Result<(), String> {
    let journal = Arc::new(VolatileRuntimeJournal::new());
    let mut runtime = Runtime::new_with_journal(shard_count(1)?, test_config(), journal.clone());
    let run = RunId::new(30003);

    assert_eq!(
        submit_action_then_finish(&runtime, run, action_then_finish_workflow()?),
        Ok(())
    );
    tick_count(&mut runtime, 2)?;

    assert_eq!(runtime.cancel_run(run), Ok(()));
    tick_and_drain(&mut runtime)?;

    let counters_before = runtime.counters_snapshot();
    let journal_before = journal
        .snapshot()
        .map_err(|e| format!("journal snapshot failed: {e:?}"))?;
    let event_count_before = journal_before.len();

    assert_eq!(runtime.kill_run(run), Ok(()));
    tick_and_drain(&mut runtime)?;

    let counters_after = runtime.counters_snapshot();
    assert_eq!(
        counters_before.runs_failed, counters_after.runs_failed,
        "failed counter unchanged after kill on cancelled run"
    );

    let journal_after = journal
        .snapshot()
        .map_err(|e| format!("journal snapshot failed: {e:?}"))?;
    let killed_count = journal_after
        .iter()
        .filter(|e| matches!(e, RuntimeJournalEvent::RunKilled { run: r } if *r == run))
        .count();
    assert_eq!(killed_count, 0, "no RunKilled event for already-cancelled run");
    assert_eq!(journal_after.len(), event_count_before, "journal unchanged");

    Ok(())
}

// =============================================================================
// C2: Cancel/Kill Missing and Already-Terminal Error Semantics (B07-B22)
// TDD RED: handle_cancel/handle_kill always return Ok(()).
// After State 10 fix, they should return typed errors.
// Tests verify side-effect-free behavior through public Runtime API.
// =============================================================================

/// B07/B11/B15: cancel on never-submitted run — no side effects.
#[test]
fn cancel_missing_run_produces_no_side_effects() -> Result<(), String> {
    let journal = Arc::new(VolatileRuntimeJournal::new());
    let mut runtime = Runtime::new_with_journal(shard_count(1)?, test_config(), journal.clone());
    let run = RunId::new(40001);

    let counters_before = runtime.counters_snapshot();
    let journal_before = journal
        .snapshot()
        .map_err(|e| format!("journal snapshot failed: {e:?}"))?;

    assert_eq!(runtime.cancel_run(run), Ok(()));
    tick_and_drain(&mut runtime)?;

    let counters_after = runtime.counters_snapshot();
    assert_eq!(
        counters_before.runs_failed, counters_after.runs_failed,
        "failed counter unchanged for missing run cancel"
    );

    let journal_after = journal
        .snapshot()
        .map_err(|e| format!("journal snapshot failed: {e:?}"))?;
    assert_eq!(journal_after.len(), journal_before.len(), "journal unchanged");

    Ok(())
}

/// B08/B12/B16: cancel on already-terminal run — no side effects.
#[test]
fn cancel_terminal_run_produces_no_side_effects() -> Result<(), String> {
    let journal = Arc::new(VolatileRuntimeJournal::new());
    let mut runtime = Runtime::new_with_journal(shard_count(1)?, test_config(), journal.clone());
    let run = RunId::new(40002);

    assert_eq!(
        submit_action_then_finish(&runtime, run, action_then_finish_workflow()?),
        Ok(())
    );
    tick_count(&mut runtime, 2)?;

    assert_eq!(runtime.cancel_run(run), Ok(()));
    tick_and_drain(&mut runtime)?;

    let counters_before = runtime.counters_snapshot();
    let journal_before = journal
        .snapshot()
        .map_err(|e| format!("journal snapshot failed: {e:?}"))?;
    let event_count_before = journal_before.len();

    // Second cancel
    assert_eq!(runtime.cancel_run(run), Ok(()));
    tick_and_drain(&mut runtime)?;

    let counters_after = runtime.counters_snapshot();
    assert_eq!(
        counters_before.runs_failed, counters_after.runs_failed,
        "failed counter unchanged on second cancel"
    );

    let journal_after = journal
        .snapshot()
        .map_err(|e| format!("journal snapshot failed: {e:?}"))?;
    let cancelled_count = journal_after
        .iter()
        .filter(|e| matches!(e, RuntimeJournalEvent::RunCancelled { run: r, .. } if *r == run))
        .count();
    assert_eq!(cancelled_count, 1, "exactly one RunCancelled event");
    assert_eq!(journal_after.len(), event_count_before, "journal unchanged");

    Ok(())
}

