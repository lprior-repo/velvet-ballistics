    true
}

proof fn lower_reduce_post_proof(id: StepIdx, input: SlotIdx, accumulator: SlotIdx,
                                  initial: ConstIdx, body: StepIdx, done: StepIdx)
    ensures {
        // Formal claim: vec![ReduceStart, ReduceNext, ReduceFinish].len() == 3
        // and ReduceNext.iterator_slot == accumulator
