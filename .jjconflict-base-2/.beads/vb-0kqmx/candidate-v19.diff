+/// Negative scenario: a supplied checkpoint with a tampered policy pin
+/// (forged to differ from the durable evidence) must be rejected by
+/// recover_retry, preserving the original state and journal.
+#[test]
+fn tampered_policy_pin_rejected_by_recover_retry() -> Result<(), String> {
+    let dir = tempfile::tempdir().map_err(|e| e.to_string())?;
+    let path = dir.path().to_path_buf();
+
+    let workflow = single_action_workflow()?;
+    let policy_digest =
+        vb_storage::admission::compute_policy_digest(&workflow).map_err(|e| e.to_string())?;
+    let contracts = contracts()?;
+    let run = RunId::new(100_003);
+
+    // Build shard config for strict policy.
+    let config = shard_config_for(RuntimePolicy::Strict);
+
+    // ---- Scope A: produce durable failure + checkpoint with real pin ----
+    let (original_checkpoint, next_seq) = {
+        let journal = Arc::new(FjallJournal::open(&path, None).map_err(|e| e.to_string())?);
+
+        vb_storage::submit_artifact_with_contracts(
+            &journal,
+            &workflow,
+            RuntimePolicy::Strict,
+            &contracts,
+        )
+        .map_err(|e| format!("artifact submit failed: {e}"))?;
+
+        let shared = runtime_journal_for_policy(journal.clone(), RuntimePolicy::Strict)?;
+        let mut runtime = Runtime::new(shard_count()?, config, shared);
+
+        runtime
+            .submit_direct_with_inputs_grants_and_contracts(
+                run,
+                workflow.clone(),
+                Box::from([(SlotIdx::ZERO, SlotValue::I64(0))]),
+                CapabilitySet::empty(),
+                contracts.clone(),
+            )
+            .map_err(|e| format!("submit failed: {e}"))?;
+        runtime
+            .tick_all()
+            .map_err(|e| format!("tick failed: {e}"))?;
+
+        let ticket = pending_ticket(&runtime, run)?;
+        runtime
+            .fail_action(ticket, non_retryable_failure())
+            .map_err(|e| format!("fail_action failed: {e}"))?;
+        runtime
+            .tick_all()
+            .map_err(|e| format!("tick failed: {e}"))?;
+
+        // Verify the real checkpoint has the correct pin.
+        let checkpoint = get_latest_checkpoint(&journal, run)?
+            .ok_or_else(|| "no durable checkpoint after failure".to_string())?;
+        let admission = checkpoint
+            .admission
+            .as_ref()
+            .ok_or_else(|| "checkpoint must contain RunAdmission")?;
+        let RunPolicyPin::Pinned(recorded) = admission.policy_pin() else {
+            return Err("checkpoint policy pin must be Pinned".to_string());
+        };
+        if recorded != policy_digest {
+            return Err(format!(
+                "checkpoint policy pin {recorded:?} != {policy_digest:?}"
+            ));
+        }
+
+        let events = journal.events_for_run(run).map_err(|e| e.to_string())?;
+        let next_seq = next_seq_after(&events)?;
+
+        drop(runtime);
+        drop(journal);
+        (checkpoint, next_seq)
+    };
+
+    // ---- Scope B: forge a checkpoint with a different policy pin ----
+    // We use a test-local serde DTO to produce a hostile admission with
+    // a tampered pin, then attach it to a clone of the real checkpoint.
+    let original_admission = original_checkpoint
+        .admission
+        .as_ref()
+        .ok_or_else(|| "original checkpoint must have admission")?;
+    let forged_pin = WorkflowDigest::from_bytes([0xFF; 32]);
+    let forged_admission = forge_admission_with_pin(original_admission, forged_pin)?;
+
+    let mut forged_checkpoint = original_checkpoint.clone();
+    forged_checkpoint.admission = Some(forged_admission);
+
+    // Record the journal state before recovery to verify no mutation.
+    let journal = Arc::new(FjallJournal::open(&path, None).map_err(|e| e.to_string())?);
+    let events_before = journal.events_for_run(run).map_err(|e| e.to_string())?;
+    let event_count_before = events_before.len();
+
+    {
+        let shared = runtime_journal_for_policy(journal.clone(), RuntimePolicy::Strict)?;
+        let runtime = Runtime::new(shard_count()?, config, shared);
+
+        // The forged checkpoint should be rejected because its pin differs
+        // from the durable evidence.
+        let result = runtime.recover_retry(run, forged_checkpoint, next_seq);
+        let Err(runtime_error) = result else {
+            return Err("tampered policy pin must be rejected by recover_retry".to_string());
+        };
+        let error_debug = format!("{runtime_error:?}");
+        if !error_debug.contains("retry checkpoint does not match durable RetryCheckpoint evidence")
+        {
+            return Err(format!(
+                "expected evidence mismatch error, got: {error_debug}"
+            ));
+        }
+    }
+
+    // Verify the journal was not mutated by the failed recovery.
+    let events_after = journal.events_for_run(run).map_err(|e| e.to_string())?;
+    if events_after.len() != event_count_before {
+        return Err(format!(
+            "journal must not be mutated by rejected recovery; before={event_count_before}, after={}",
+            events_after.len()
+        ));
+    }
+
+    // Verify the original checkpoint still has the correct pin.
+    let still_original = get_latest_checkpoint(&journal, run)?
+        .ok_or_else(|| "checkpoint must still exist after rejected recovery".to_string())?;
+    let still_original_admission = still_original
+        .admission
+        .as_ref()
+        .ok_or_else(|| "original checkpoint admission must still exist")?;
+    let RunPolicyPin::Pinned(still_recorded) = still_original_admission.policy_pin() else {
+        return Err("original checkpoint pin must still be Pinned".to_string());
+    };
+    if still_recorded != policy_digest {
+        return Err(format!(
+            "original checkpoint pin must be unchanged; got {still_recorded:?}"
+        ));
+    }
+
+    Ok(())
+}
+
+/// vb-h7rex: A retry checkpoint whose admission policy pin differs from the
+/// durable artifact's policy_digest must be rejected by recover_retry with
+/// the admission_policy_pin_mismatch reason. The checkpoint validation
+/// validates value equality, but the shard must additionally validate the
+/// admission policy pin before restoring run state.
+#[test]
+fn admission_policy_pin_mismatch_rejected_by_recover_retry() -> Result<(), String> {
+    let dir = tempfile::tempdir().map_err(|e| e.to_string())?;
+    let path = dir.path().to_path_buf();
+
+    let workflow = single_action_workflow()?;
+    let policy_digest =
+        vb_storage::admission::compute_policy_digest(&workflow).map_err(|e| e.to_string())?;
+    let contracts = contracts()?;
+    let run = RunId::new(100_005);
+
+    // Build shard config for strict policy.
+    let config = shard_config_for(RuntimePolicy::Strict);
+
+    // ---- Scope A: produce durable failure + checkpoint with correct pin ----
+    let (original_checkpoint, original_events) = {
+        let journal = Arc::new(FjallJournal::open(&path, None).map_err(|e| e.to_string())?);
+
+        vb_storage::submit_artifact_with_contracts(
+            &journal,
+            &workflow,
+            RuntimePolicy::Strict,
+            &contracts,
+        )
+        .map_err(|e| format!("artifact submit failed: {e}"))?;
+
+        let shared = runtime_journal_for_policy(journal.clone(), RuntimePolicy::Strict)?;
+        let mut runtime = Runtime::new(shard_count()?, config, shared);
+
+        runtime
+            .submit_direct_with_inputs_grants_and_contracts(
+                run,
+                workflow.clone(),
+                Box::from([(SlotIdx::ZERO, SlotValue::I64(0))]),
+                CapabilitySet::empty(),
+                contracts.clone(),
+            )
+            .map_err(|e| format!("submit failed: {e}"))?;
+        runtime
+            .tick_all()
+            .map_err(|e| format!("tick failed: {e}"))?;
+
+        let ticket = pending_ticket(&runtime, run)?;
+        runtime
+            .fail_action(ticket, non_retryable_failure())
+            .map_err(|e| format!("fail_action failed: {e}"))?;
+        runtime
+            .tick_all()
+            .map_err(|e| format!("tick failed: {e}"))?;
+
+        // Verify the real checkpoint has the correct pin.
+        let checkpoint = get_latest_checkpoint(&journal, run)?
+            .ok_or_else(|| "no durable checkpoint after failure".to_string())?;
+        let admission = checkpoint
+            .admission
+            .as_ref()
+            .ok_or_else(|| "checkpoint must contain RunAdmission")?;
+        let RunPolicyPin::Pinned(recorded) = admission.policy_pin() else {
+            return Err("checkpoint policy pin must be Pinned".to_string());
+        };
+        if recorded != policy_digest {
+            return Err(format!(
+                "checkpoint policy pin {recorded:?} != {policy_digest:?}"
+            ));
+        }
+
+        // Capture the original journal state (events before any forging).
+        let original_events = journal.events_for_run(run).map_err(|e| e.to_string())?;
+
+        drop(runtime);
+        drop(journal);
+        (checkpoint, original_events)
+    };
+
+    // ---- Scope B: forge a checkpoint with a wrong policy pin ----
+    // The checkpoint validation validates value equality (supplied matches durable),
+    // so we must persist the forged checkpoint as the durable checkpoint.
+    let original_admission = original_checkpoint
+        .admission
+        .as_ref()
+        .ok_or_else(|| "original checkpoint must have admission")?;
+
+    // Positive control: the same DTO helper used to construct forged admissions
+    // must produce an admission that fully matches the original when given the
+    // original (real) policy pin. This verifies the serialization/deserialization
+    // path is faithful before testing the mismatch case.
+    let real_pin_reconstruction = forge_admission_with_pin(original_admission, policy_digest)?;
+    if real_pin_reconstruction != *original_admission {
+        return Err(
+            "positive control failed: reconstructing with original pin must equal original admission"
+                .to_string(),
+        );
+    }
+
+    let forged_pin = WorkflowDigest::from_bytes([0xEE; 32]);
+    let forged_admission = forge_admission_with_pin(original_admission, forged_pin)?;
+
+    // Verify forged pin differs from the real policy digest.
+    if forged_pin == policy_digest {
+        return Err("forged pin must differ from the real policy digest".to_string());
+    }
+
+    // Verify the forged admission has the correct pin.
+    match forged_admission.policy_pin() {
+        vb_storage::RunPolicyPin::Pinned(pin) => {
+            if pin != forged_pin {
+                return Err(format!(
+                    "forged admission pin {:?} != expected {:?}",
+                    pin, forged_pin
+                ));
+            }
+        }
+        other => {
+            return Err(format!(
+                "forged admission policy_pin is not Pinned: {other:?}"
+            ));
+        }
+    }
+
+    // The forged checkpoint must have an incremented run_attempt and prior_seq
+    // pointing to a new RunFailed event, so the durable chain validation passes.
+    let next_attempt = original_checkpoint
+        .run_attempt
+        .checked_add(1)
+        .ok_or_else(|| "run_attempt overflow".to_string())?;
+    let mut forged_checkpoint = original_checkpoint.clone();
+    forged_checkpoint.admission = Some(forged_admission);
+    forged_checkpoint.run_attempt = next_attempt;
+
+    // ---- Scope C: persist the forged checkpoint as the durable checkpoint ----
+    let journal = Arc::new(FjallJournal::open(&path, None).map_err(|e| e.to_string())?);
+    let events = journal.events_for_run(run).map_err(|e| e.to_string())?;
+    let next_seq = next_seq_after(&events)?;
+
+    // Construct the new RunFailed event (attempt = original run_attempt).
+    let run_failed_seq = next_seq;
+    let run_failed_event = JournalEvent::RunFailedEvent {
+        run,
+        seq: run_failed_seq,
+        attempt: original_checkpoint.run_attempt.get(),
+    };
+    journal
+        .append_strict(&run_failed_event)
+        .map_err(|e| format!("failed to append new RunFailed event: {e}"))?;
+
+    // Update the forged checkpoint's prior_seq to the new RunFailed seq.
+    forged_checkpoint.prior_seq = run_failed_seq.get();
+
+    // Append the forged checkpoint.
+    let checkpoint_seq = next_seq_after(&journal.events_for_run(run).map_err(|e| e.to_string())?)?;
+    let forged_payload =
+        postcard::to_allocvec(&forged_checkpoint).map_err(|e| format!("encode failed: {e}"))?;
+    let forged_payload_digest = blake3::hash(&forged_payload);
+    let forged_checkpoint_event = JournalEvent::RetryCheckpoint {
+        run,
+        seq: checkpoint_seq,
+        attempt: next_attempt.get(),
+        step: forged_checkpoint.retry_step,
+        payload_digest: *forged_payload_digest.as_bytes(),
+        payload: forged_payload,
+    };
+    journal
+        .append_strict(&forged_checkpoint_event)
+        .map_err(|e| format!("failed to append forged checkpoint: {e}"))?;
+
+    // Drop all journal handles and reopen to force durability. The journal
+    // must be closed before the runtime attempts recovery, ensuring the
+    // forged checkpoint is persisted on disk and not just in the write-ahead
+    // log buffer.
+    drop(journal);
+    let journal = Arc::new(FjallJournal::open(&path, None).map_err(|e| e.to_string())?);
+
+    // Verify the forged checkpoint was durably persisted and is the latest.
+    let persisted_checkpoint = get_latest_checkpoint(&journal, run)?
+        .ok_or_else(|| "no durable checkpoint after forging".to_string())?;
+    if persisted_checkpoint != forged_checkpoint {
+        return Err("persisted checkpoint must fully equal the forged checkpoint".to_string());
+    }
+
+    let next_seq_for_recovery =
+        next_seq_after(&journal.events_for_run(run).map_err(|e| e.to_string())?)?;
+
+    // Record the journal state before recovery to verify no mutation on rejection.
+    let events_before = journal.events_for_run(run).map_err(|e| e.to_string())?;
+
+    {
+        let shared = runtime_journal_for_policy(journal.clone(), RuntimePolicy::Strict)?;
+        let mut runtime = Runtime::new(shard_count()?, config, shared);
+
+        // recover_retry enqueues the command; shard validates on processing.
+        runtime
+            .recover_retry(run, forged_checkpoint, next_seq_for_recovery)
+            .map_err(|e| format!("recover_retry failed: {e}"))?;
+
+        // The forged checkpoint matches the durable checkpoint (value equality),
+        // so validate_retry_checkpoint_against_durable_chain passes. But the shard
+        // must reject it during tick processing due to the admission policy pin mismatch.
+        let result = runtime.tick_all();
+        let Err(runtime_error) = result else {
+            return Err("forged policy pin must be rejected during tick processing".to_string());
+        };
+
+        // Verify the error is RecoveryCannotResume with the exact expected reason.
+        match runtime_error {
+            RuntimeError::RecoveryCannotResume { reason } => {
+                if reason != "admission_policy_pin_mismatch" {
+                    return Err(format!(
+                        "expected reason 'admission_policy_pin_mismatch', got: {reason}"
+                    ));
+                }
+            }
+            other => {
+                return Err(format!(
+                    "expected RecoveryCannotResume error, got: {other:?}"
+                ));
+            }
+        }
+    }
+
+    // Verify the journal was not mutated by the failed recovery.
+    let events_after = journal.events_for_run(run).map_err(|e| e.to_string())?;
+    if events_after != events_before {
+        return Err(format!(
+            "journal must not be mutated by rejected recovery; before={} events, after={} events, \
+             full vec equality failed",
+            events_before.len(),
+            events_after.len()
+        ));
+    }
+    // Verify the original prefix (events before the forged failure/checkpoint were appended)
+    // is still complete and unchanged in the final journal state.
+    if !events_after
+        .iter()
+        .take(original_events.len())
+        .eq(original_events.iter())
+    {
+        return Err("original journal prefix must be complete and unchanged".to_string());
+    }
+
+    Ok(())
+}
