e = CapabilityScopeSpec {\n        namespace: 15,\n        key: 30,\n    };\n    let register_path = fixture.dir.path().join(\"register\");\n    let mut adapter = FjallRegister::open(&register_path, 8)?;\n    let result = fixture.runtime.execute_registered_action(\n        &mut adapter,\n        fixture.run,\n        0,\n        &grant,\n        ScopedDispatch::new(&scoped, &dispatch, &[]),\n    );\n    assert!(matches!(\n        result,\n        Err(RegisteredExecutionError::Executor(ExecutorError::Grant(\n            GrantError::ScopeMismatch\n        )))\n    ));\n    assert_eq!(adapter.effect_count()?, 0);\n    Ok(())\n}","associated_obligation":"Changed dispatch scope rejects with ScopeMismatch and adapter effect count remains zero.","evidence_kind":"source_assertions_plus_exact_native_registration_only","execution":"UNEXECUTED","acceptance_proved":false}],"static_checks":[],"untested_or_unproved_obligations":[{"obligation":"Full requirement scope beyond the expressly quoted narrow examples: Only current NORMATIVE-V1/V1-MIN portions; strict-profile/target/deferred extensions excluded.","disposition":"UNRESOLVED_REMAINDER","planned_check":"Review existing registered suites against every remaining clause of 77.10; preserve mapped checks above and name additional checks only after source assertion inspection."},{"obligation":"Actual execution results, assertion success, current-source applicability and any required proof/acceptance closure for 77.10","disposition":"UNEXECUTED_UNPROVED","planned_check":"Parent must select accepted revision and run applicable approved checks; native registration at 05dd9bcc supplies no result."}],"existing_source_evidence_guidance":[],"ownership_reference":"/tmp/vb-core-current-normalized-190-plan.json#77.10","ownership_reconciled_here":false,"excluded_scope_disposition":["Strict-profile and TARGET-only extensions require an explicit opt-in; DEFERRED additions cannot block current v1-min."],"completion_verified":false,"implementatio