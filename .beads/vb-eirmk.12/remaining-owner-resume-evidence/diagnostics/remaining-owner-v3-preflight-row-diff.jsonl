y":"acceptance_point","requirement":"Binary IPC implements `SubmitRun`, `SubmitRunInline`, `CancelRun`, `InspectRun`, `ListEvents`, `AnswerAsk`, `CompleteAction`, `FailAction`, `DrainTrace`, `Health`, and `Shutdown`.","required_scope":"Binary IPC implements `SubmitRun`, `SubmitRunInline`, `CancelRun`, `InspectRun`, `ListEvents`, `AnswerAsk`, `CompleteAction`, `FailAction`, `DrainTrace`, `Health`, and `Shutdown`.","master_ref":{"path":"velvet-ballistics-MASTER.md","line":1909,"line_text":"16. Binary IPC implements `SubmitRun`, `SubmitRunInline`, `CancelRun`, `InspectRun`, `ListEvents`, `AnswerAsk`, `CompleteAction`, `FailAction`, `DrainTrace`, `Health`, and `Shutdown`."},"mapping_verdict":"PARTIAL_EXACT_NATIVE_MAPPING","exact_native_checks":[{"check_id":"velvet-ballistics-workspace-tests::vb_te1i_binary_ipc_acceptance::ipc_rejects_bad_magic_before_payload_allocation","binary_id":"velvet-ballistics-workspace-tests::vb_te1i_binary_ipc_acceptance","binary_name":"vb_te1i_binary_ipc_acceptance","package_name":"velvet-ballistics-workspace-tests","test_name":"ipc_rejects_bad_magic_before_payload_allocation","registration":{"kind":"test","ignored":false,"filter-match":{"status":"matches"}},"source_revision":"05dd9bcc650174dcb3eda41aa162a40cd0fa39ea","source_path":"crates/workspace_tests/tests/vb_te1i_binary_ipc_acceptance.rs","source_line":288,"quoted_test_contract":"fn ipc_rejects_bad_magic_before_payload_allocation() {\n    let path = temp_socket_path(\"bdd003_bad_magic\");\n    let _cleanup = CleanupPath(path.clone());\n\n    let mut server = IpcServer::bind(&path).expect(\"bind should succeed\");\n    let mut runtime = make_runtime();\n    let mut client = UnixStream::connect(&path).expect(\"client should connect\");\n\n    server\n        .poll_once(&mut runtime, Some(Duration::from_millis(100)))\n        .expect(\"accept poll should succeed\");\n\n    // Build a frame with INVALID magic bytes (0xDEAD_BEEF).\n    let mut bad_frame = build_frame(IpcCommand::Health, 0, &[]);\n    bad_frame[0..4].copy_from_slice(&0xDEAD_BEEF_u32.to_le_bytes());\n\n    client\n        .write_all(&bad_frame)\n        .expect(\"client should write bad magic frame\");\n    client.flush().expect(\"client should flush\");\n\n    server\n        .poll_once(&mut runtime, Some(Duration::from_millis(100)))\n        .expect(\"process poll should succeed\");\n\n    // Early validation consumes only the four magic bytes. Unix may reset a\n    // socket closed with unread request bytes; both terminal outcomes must\n    // carry zero response bytes. WouldBlock is not a successful rejection.\n    match client.read(&mut [0; IPC_HEADER_LEN]) {\n        Ok(0) => {}\n        Err(error) if error.kind() == std::io::ErrorKind::ConnectionReset => {}\n        result => panic!(\"bad magic must disconnect with no response bytes: {result:?}\"),\n    }\n    // Internal removal is also asserted by the production server unit test\n    // server_disconnects_invalid_magic_without_response.\n\n    let mut healthy = std::os::unix::net::UnixStream::connect(&path).expect(\"healthy connect\");\n    healthy\n        .set_read_timeout(Some(Duration::from_millis(200)))\n        .expect(\"bounded read\");\n    healthy\n        .write_all(&build_frame(IpcCommand::Health, 91, &[]))\n        .expect(\"health request\");\n    server\n        .poll_once(&mut runtime, Some(Duration::from_millis(10)))\n        .expect(\"healthy poll\");\n    let mut bytes = [0; IPC_HEADER_LEN];\n    healthy\n        .read_exact(&mut bytes)\n        .expect(\"healthy response header\");\n    let header = IpcFrameHeader::decode(&bytes, MaxPayloadBytes::DEFAULT).expect(\"valid response\");\n    let mut payload = vec![0; usize::try_from(header.payload_len).expect(\"payload length\")];\n    healthy\n        .read_exact(&mut payload)\n        .expect(\"healthy response payload\");\n    assert_eq!(header.correlation, 91);\n    assert_eq!(\n        postcard::from_bytes::<IpcResponse>(&payload).expect(\"typed response\"),\n        IpcResponse::Healthy\n    );\n}","associated_obligation":"Bad-magic connection closes with no response bytes and another health client remains responsive; no allocation counter assertion.","evidence_kind":"source_assertions_plus_exact_native_registration_only","execution":"UNEXECUTED","acceptance_proved":false}],"static_checks":[],"untested_or_unproved_obligations":[{"obligation":"Full requirement scope beyond the expressly quoted narrow examples: Binary IPC implements `SubmitRun`, `SubmitRunInline`, `CancelRun`, `InspectRun`, `ListEvents`, `AnswerAsk`, `CompleteAction`, `FailAction`, `DrainTrace`, `Health`, and `Shutdown`.","disposition":"UNRESOLVED_REMAINDER","planned_check":"Review existing registered suites against every remaining clause of master44.16; preserve mapped checks above and name additional checks only after source assertion inspection."},{"obligation":"Actual execution results, assertion success, current-source applicability and any required proof/acceptance closure for master44.16","disposition":"UNEXECUTED_UNPROVED","planned_check":"Parent must select accepted revision and run applicable approved checks; native registration at 05dd9bcc supplies no result."}],"existing_source_evidence_guidance":[],"ownership_reference":"/tmp/vb-core-current-normalized-190-plan.json#master44.16","ownership_reconciled_here":false,"excluded_scope_disposition":[],"completion_verified":false,"implementation_missing":null},"proposal":null}}}
