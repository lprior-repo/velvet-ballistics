{"label": "mechanical-function-size", "cwd": "/home/lewis/src/isoloated/velvet-ballistics-vb-2a9i3-ipc-reviewfix-sol", "argv": ["python", "-c", "from pathlib import Path\nimport re,json\npaths=['crates/vb_ipc/src/server/connection_io.rs','crates/vb_ipc/src/server/reactor.rs','crates/vb_ipc/src/server/response_io.rs','crates/vb_storage/src/queue/writer/flush.rs','crates/vb_ipc/src/server/helpers.rs']\nrows=[]\nfor name in paths:\n lines=Path(name).read_text().splitlines()\n if not name.endswith('helpers.rs'): assert len(lines)<300,(name,len(lines))\n for i,line in enumerate(lines):\n  match=re.search(r'\\bfn\\s+(\\w+)',line)\n  if not match or (name.endswith('helpers.rs') and match.group(1)!='send_response'): continue\n  depth=0; opened=False\n  for j in range(i,len(lines)):\n   depth+=lines[j].count('{')-lines[j].count('}'); opened|='{' in lines[j]\n   if opened and depth==0:\n    row={'file':name,'function':match.group(1),'line':i+1,'physical_lines':j-i+1}\n    assert row['physical_lines']<=25,row\n    rows.append(row);break\nprint(json.dumps(rows,indent=2))\nprint('PASS',len(rows),'functions, max',max(row['physical_lines'] for row in rows))\n"], "exit_code": 0, "duration_seconds": 0.013, "cargo_build_jobs": 2, "stdout": ".beads/vb-2a9i3-reviewfix/raw/mechanical-function-size.stdout", "stderr": ".beads/vb-2a9i3-reviewfix/raw/mechanical-function-size.stderr", "stdout_sha256": "31b00815905b9150c465806c9e97ea894cc757c02103b7e9610a46ac9898b78a", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}
