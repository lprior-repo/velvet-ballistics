+
+type CaseResult<T> = Result<T, Box<dyn std::error::Error>>;
+
+struct TestCase {
+    dir: tempfile::TempDir,
+    run: RunId,
+    journal: Arc<FjallJournal>,
+    artifact: AcceptedArtifact,
+    runtime: Runtime,
+    ticket: ActionTicket,
