+}
+
+fn strict_config() -> ShardConfig {
+    ShardConfig {
+        command_queue_capacity: 32,
+        trace_capacity: 64,
+        step_budget_per_tick: 16,
+        max_active_runs: 8,
+        policy: RuntimePolicy::Strict,
+    }
+}
+
+fn scope() -> CapabilityScopeSpec {
+    CapabilityScopeSpec {
+        namespace: 15,
+        key: 29,
+    }
+}
