+fn external_contract(action: ActionId) -> Result<ActionContract, Box<dyn std::error::Error>> {
+    Ok(ActionContract {
+        id: action,
+        name: ActionName::new("vb_c4hzw_legacy_action")?,
+        input_slot_count: 1,
+        output_slot_count: 1,
+        max_input_bytes: 64,
+        max_output_bytes: 64,
+        timeout_ms: 1000,
+        idempotency: Idempotency::IdempotentExternal,
+        side_effect: SideEffect::Writes,
