+        node(StepIdx::new(3), CompiledNodeKind::Finish { result: SlotIdx::new(0) }, None),
+    ];
+    assert!(matches!(WholeWorkflowBudget::compute(&nodes, StepIdx::new(0), &ResourceContract::DEFAULT), Err(WorkflowError::StepCountOverflow { actual }) if actual > u64::from(u32::MAX)));
+}
+
+fn workflow_parts(nodes: Vec<CompiledNode>) -> vb_core::WorkflowParts {
+    vb_core::WorkflowParts {
+        name: "budget-owner-depth".into(),
+        digest: vb_core::WorkflowDigest::from_bytes([0x36; 32]),
+        semantic_source_identity: None,
+        nodes: nodes.into_boxed_slice(),
+        expressions: Box::new([]),
+        accessors: Box::new([]),
+        constants: Box::new([]),
+        slot_count: 8,
+        symbols_count: 0,
+        entry: StepIdx::new(0),
+        resource_contract: ResourceContract::DEFAULT,
+        step_names: Box::new([]),
+        input_slots: Box::new([]),
+    }
+}
+
+fn shared_body_owner_nodes(short_owner_first: bool) -> Vec<CompiledNode> {
+    let (first, second) = if short_owner_first { (2, 1) } else { (1, 2) };
+    vec![
+        node(StepIdx::new(0), CompiledNodeKind::ChooseSlot {
+            branches: vec![vb_core::SlotBranch { condition: SlotIdx::new(0), target: StepIdx::new(first) }].into_boxed_slice(),
+            otherwise: Some(StepIdx::new(second)),
+        }, None),
+        node(StepIdx::new(1), CompiledNodeKind::ForEachStart { input: SlotIdx::new(1), item_slot: SlotIdx::new(2), limit: 1, body: StepIdx::new(3), done: StepIdx::new(12) }, None),
+        node(StepIdx::new(2), CompiledNodeKind::ForEachStart { input: SlotIdx::new(3), item_slot: SlotIdx::new(4), limit: 1, body: StepIdx::new(3), done: StepIdx::new(6) }, None),
+        node(StepIdx::new(3), CompiledNodeKind::Nop, Some(StepIdx::new(4))),
+        node(StepIdx::new(4), CompiledNodeKind::Nop, Some(StepIdx::new(5))),
+        node(StepIdx::new(5), CompiledNodeKind::Nop, Some(StepIdx::new(6))),
+        node(StepIdx::new(6), CompiledNodeKind::Nop, Some(StepIdx::new(7))),
+        node(StepIdx::new(7), CompiledNodeKind::TogetherStart { branches: vec![StepIdx::new(8)].into_boxed_slice(), join: StepIdx::new(11) }, None),
+        node(StepIdx::new(8), CompiledNodeKind::TogetherBranch { branch: 0, entry: StepIdx::new(9), join: StepIdx::new(11), accumulator: SlotIdx::new(5) }, None),
+        node(StepIdx::new(9), CompiledNodeKind::WaitUntil { deadline_slot: SlotIdx::new(6) }, Some(StepIdx::new(10))),
+        node(StepIdx::new(10), CompiledNodeKind::Nop, Some(StepIdx::new(11))),
+        node(StepIdx::new(11), CompiledNodeKind::TogetherJoin { branch_count: 1, accumulator: SlotIdx::new(5) }, Some(StepIdx::new(12))),
+        node(StepIdx::new(12), CompiledNodeKind::Finish { result: SlotIdx::new(7) }, None),
+    ]
+}
+
+#[test]
+fn shared_body_with_different_owner_exits_is_order_independent() -> TestResult {
+    for short_owner_first in [true, false] {
+        let nodes = shared_body_owner_nodes(short_owner_first);
+        let actual = budget(&nodes)?;
+        assert_eq!(actual.max_nesting_depth, 2);
+        assert_eq!(actual.max_for_each_iterations, 2);
+        assert_eq!(actual.max_timer_entries, 1);
+        let workflow = vb_core::CompiledWorkflow::try_from_parts(workflow_parts(nodes))
+            .map_err(|error| format!("valid shared-body constructor rejected: {error:?}"))?;
+        assert_eq!(workflow.entry(), StepIdx::new(0));
+    }
+    Ok(())
+}
+
+#[test]
+fn genuinely_nested_loop_constructor_preserves_depth_policy() -> TestResult {
+    for depth in [8, 9] {
+        let mut nodes = nested_together_nodes(depth)?;
+        for candidate in &mut nodes {
+            candidate.kind = match &candidate.kind {
+                CompiledNodeKind::TogetherStart { branches, join } => CompiledNodeKind::ForEachStart {
+                    input: SlotIdx::new(0),
+                    item_slot: SlotIdx::new(1),
+                    limit: 1,
+                    body: *branches.first().ok_or("missing nested body")?,
+                    done: *join,
+                },
+                CompiledNodeKind::TogetherJoin { .. } => CompiledNodeKind::ForEachJoin { output: SlotIdx::new(1) },
+                kind => kind.clone(),
+            };
+        }
+        assert_eq!(budget(&nodes)?.max_nesting_depth, depth);
+        let result = vb_core::CompiledWorkflow::try_from_parts(workflow_parts(nodes));
+        if depth == 8 {
+            assert!(result.is_ok(), "depth 8 constructor failed: {result:?}");
+        } else {
+            assert!(matches!(result, Err(WorkflowError::BudgetPolicyExceeded { detail: "max_nesting_depth" })));
+        }
+    }
+    Ok(())
+}
+
+#[test]
+fn unreachable_owners_do_not_affect_structural_depth() -> TestResult {
+    let mut nodes = vec![node(StepIdx::new(0), CompiledNodeKind::Finish { result: SlotIdx::new(0) }, None)];
+    append_together(&mut nodes, 10)?;
+    finish(&mut nodes)?;
+    let actual = budget(&nodes)?;
+    assert_eq!(actual.max_nesting_depth, 0);
+    assert_eq!(actual.max_fanout, 0);
+    Ok(())
+}
