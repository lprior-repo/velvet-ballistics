+#[test]
+fn backward_scope_exit_keeps_typed_rejection() {
+    let nodes = vec![
+        node(StepIdx::new(0), CompiledNodeKind::Nop, Some(StepIdx::new(1))),
+        node(StepIdx::new(1), CompiledNodeKind::TogetherStart { branches: vec![StepIdx::new(2)].into_boxed_slice(), join: StepIdx::new(0) }, None),
+        node(StepIdx::new(2), CompiledNodeKind::Finish { result: SlotIdx::new(0) }, None),
+    ];
+    assert!(matches!(WholeWorkflowBudget::compute(&nodes, StepIdx::new(0), &ResourceContract::DEFAULT), Err(WorkflowError::BackwardEdge { from, to }) if from == StepIdx::new(1) && to == StepIdx::new(0)));
+}
