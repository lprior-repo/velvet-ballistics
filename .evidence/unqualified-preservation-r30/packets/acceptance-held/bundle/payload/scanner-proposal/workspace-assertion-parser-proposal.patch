+#[cfg(test)]
+mod dependency_names_tests {
+    use super::dependency_names;
+
+    #[test]
+    fn workspace_dependency_key_is_normalized() {
+        let names = dependency_names("[dependencies]\nserde_json.workspace = true\n");
+        assert!(names.contains("serde_json"));
+    }
+
+    #[test]
+    fn plain_dependency_name_is_preserved() {
+        let names = dependency_names("[dependencies]\nserde_json = \"1\"\n");
+        assert!(names.contains("serde_json"));
+    }
+
+    #[test]
+    fn renamed_package_alias_and_package_name_are_preserved() {
+        let names = dependency_names(
+            "[dependencies]\njson_alias = { package = \"serde_json\", version = \"1\" }\n",
+        );
+        assert!(names.contains("json_alias"));
+        assert!(names.contains("serde_json"));
+    }
