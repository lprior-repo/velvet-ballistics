+    /// Per M-HN4SC-1 / W-HN4SC-2: the byte-budget gate fires BEFORE any
+    /// `owned_batch.commit()`; on rejection, the durable store is
+    /// untouched even if earlier events in the same flush were staged
+    /// into the `OwnedWriteBatch`.
+    #[test]
+    fn flush_batch_byte_budget_rejection_skips_commit() {
+        let (_temp, journal) = temp_journal();
+        // budget 100 -> first event (95 bytes) fits, second event (95+95=190)
+        // exceeds and the gate must reject before commit.
+        let queue = JournalWriterQueue::new(4, 4, limits_with_byte_budget(100))
+            .expect("queue creation should succeed");
+        let run = RunId::new(4);
+        queue
+            .enqueue_journaled(make_event(run, 0))
+            .expect("first enqueue should succeed");
+        queue
+            .enqueue_journaled(make_event(run, 1))
+            .expect("second enqueue should succeed");
+        let result = queue.flush_batch(&journal);
+        match result {
+            Err(JournalError::JournalBatchBytesExceeded { attempted, limit }) => {
+                assert_eq!(
+                    attempted,
+                    RUN_ACCEPTED_ENCODED_LEN.saturating_mul(2),
+                    "attempted must equal accumulated bytes (95 + 95 = 190) at the rejecting event",
+                );
+                assert_eq!(limit, 100);
+            }
+            other => panic!(
+                "expected JournalBatchBytesExceeded on second event, got {:?}",
+                other,
+            ),
+        }
+        // Per W-HN4SC-3 + M-HN4SC-1: pending queue retains BOTH events;
+        // the durable store contains NEITHER (no commit happened).
+        let counts = queue
+            .pending_profile_counts()
+            .expect("counts should succeed");
+        assert_eq!(
+            counts.journaled, 2,
+            "both events must remain queued after a rejected flush",
+        );
+        let events = journal.events_for_run(run).expect("replay should succeed");
+        assert!(
+            events.is_empty(),
+            "durable store must be empty after rejected flush, got {} events",
+            events.len(),
+        );
+    }
+
+    /// Per W-HN4SC-6: `drain_all` short-circuits on the first
+    /// `JournalBatchBytesExceeded` and surfaces the error via `?`.
+    #[test]
+    fn drain_all_short_circuits_on_byte_budget_rejection() {
+        let (_temp, journal) = temp_journal();
+        let queue = JournalWriterQueue::new(8, 8, limits_with_byte_budget(90))
+            .expect("queue creation should succeed");
+        let run = RunId::new(5);
+        for i in 0..5u64 {
+            queue
+                .enqueue_journaled(make_event(run, i))
+                .unwrap_or_else(|_| panic!("enqueue {} should succeed", i));
+        }
+        let result = queue.drain_all(&journal);
+        match result {
+            Err(JournalError::JournalBatchBytesExceeded { attempted, limit }) => {
+                assert_eq!(attempted, RUN_ACCEPTED_ENCODED_LEN);
+                assert_eq!(limit, 90);
+            }
+            other => panic!(
+                "drain_all must propagate byte-budget error, got {:?}",
+                other,
+            ),
+        }
+        // Pending queue is intact; durable store is empty.
+        let counts = queue
+            .pending_profile_counts()
+            .expect("counts should succeed");
+        assert_eq!(
+            counts.journaled, 5,
+            "all 5 events must remain queued after drain_all short-circuit",
+        );
+        let events = journal.events_for_run(run).expect("replay should succeed");
+        assert!(
+            events.is_empty(),
+            "durable store must be empty after drain_all short-circuit",
+        );
+    }
