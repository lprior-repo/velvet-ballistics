+    // ========================================================================
+    // vb-hn4sc — byte-budget gate tests
+    // ========================================================================
+    //
+    // These tests cover the per-flush encoded-byte budget that
+    // `JournalWriterQueue::flush_batch` enforces via the previously-ignored
+    // `StorageLimits::max_journal_batch_bytes` field. The default
+    // `StorageLimits::DEFAULT.max_journal_batch_bytes == 1_048_636`
+    // accommodates exactly one max-size journal event. Tests that exercise
+    // the gate boundary use a smaller custom budget so the rejection path
+    // is reachable without staging 10k+ events.
+
+    /// Per AC-1.4: `StorageLimits::DEFAULT.max_journal_batch_bytes` equals
+    /// `DEFAULT_JOURNAL_BATCH_BYTE_LIMIT + 60`.
+    #[test]
+    fn storage_limits_default_batch_bytes_equals_payload_basis_plus_header() {
+        assert_eq!(
+            StorageLimits::DEFAULT.max_journal_batch_bytes,
+            1_048_636,
+            "default byte budget must be payload basis (1_048_576) + 60-byte header",
+        );
+    }
+
+    /// Per B-HN4SC-8: `with_contracts` signature is preserved.
+    #[test]
+    fn with_contracts_captures_byte_budget_from_storage_limits() {
+        let limits = limits_with_byte_budget(123);
+        let queue = JournalWriterQueue::with_contracts(
+            JournalQueueCapacity::new(NonZeroUsize::new(4).expect("non-zero")),
+            JournalBatchSize::new(NonZeroUsize::new(2).expect("non-zero")),
+            limits,
+        )
+        .expect("construction with valid limits should succeed");
+        assert_eq!(
+            queue.byte_budget(),
+            123,
+            "byte_budget must mirror StorageLimits::max_journal_batch_bytes",
+        );
+    }
+
+    /// Per AC-1.1: a single event whose encoded length exceeds the
+    /// configured `byte_budget` returns `JournalBatchBytesExceeded`.
+    #[test]
+    fn flush_batch_rejects_when_encoded_bytes_exceed_byte_budget() {
+        let (_temp, journal) = temp_journal();
+        // 95-byte event + 5-byte headroom -> reject first event.
+        let queue = JournalWriterQueue::new(2, 2, limits_with_byte_budget(90))
+            .expect("queue creation should succeed");
+        // RunId < 128 -> single varint byte -> encoded length stays 95.
+        let run = RunId::new(1);
+        queue
+            .enqueue_journaled(make_event(run, 0))
+            .expect("enqueue under capacity should succeed");
+        let result = queue.flush_batch(&journal);
+        match result {
+            Err(JournalError::JournalBatchBytesExceeded { attempted, limit }) => {
+                assert_eq!(
+                    attempted, RUN_ACCEPTED_ENCODED_LEN,
+                    "attempted must equal encoded length of the staged event (95)",
+                );
+                assert_eq!(limit, 90, "limit must equal configured byte_budget (90)",);
+            }
+            other => panic!("expected JournalBatchBytesExceeded, got {:?}", other,),
+        }
+        // Per W-HN4SC-3 / M-HN4SC-1: pending queue is preserved on
+        // rejection; no partial commit reached the durable store.
+        let counts = queue
+            .pending_profile_counts()
+            .expect("counts should succeed");
+        assert_eq!(
+            counts.journaled, 1,
+            "rejected event must remain queued for the next flush",
+        );
+        let events = journal.events_for_run(run).expect("replay should succeed");
+        assert!(
+            events.is_empty(),
+            "durable store must remain empty after a rejected flush",
+        );
+    }
+
