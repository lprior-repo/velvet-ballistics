+    // Probe helper for tests that need a known encoded length.
+    //
+    // `make_event` (RunAccepted with a 32-byte zero digest) encodes to
+    // exactly 95 bytes: 60-byte header + 35-byte postcard payload. The
+    // tests below treat this value as canonical.
+    const RUN_ACCEPTED_ENCODED_LEN: u64 = 95;
+
+    // Probe helper for a near-max-size event whose encoded length is
+    // verified to fall in the band that lets us exercise the byte
+    // budget against the existing `JournalWriteBatch::byte_limit`
+    // default of `DEFAULT_JOURNAL_BATCH_BYTE_LIMIT = 1_048_576`.
+    //
+    // `SlotWrittenEvent { value: Some(vec![0u8; 1_048_560]), extra: None,
+    // attempt: 1 }` postcard-encodes to 1_048_570 bytes (under
+    // `MAX_JOURNAL_EVENT_PAYLOAD_BYTES`) and the full record encodes
+    // to 1_048_630 bytes (header + payload). That encoded length is
+    // 54 bytes over `1_048_576`, so `JournalWriteBatch` rejects it
+    // while a `JournalWriterQueue` with the matching custom
+    // `max_journal_batch_bytes = 1_048_576` also rejects with the
+    // identical error variant and field values.
+    const NEAR_MAX_VALUE_LEN: usize = 1_048_560;
+    const NEAR_MAX_ENCODED_LEN: u64 = 1_048_630;
+
+    fn make_near_max_event(run: RunId, seq: u64) -> JournalEvent {
+        JournalEvent::SlotWrittenEvent {
+            run,
+            seq: EventSeq::new(seq),
+            slot: SlotIdx::new(0),
+            value: Some(vec![0u8; NEAR_MAX_VALUE_LEN]),
+            extra: None,
+            attempt: 1,
+        }
+    }
+
+    fn limits_with_byte_budget(budget: u64) -> StorageLimits {
+        StorageLimits {
+            max_journal_event_payload_bytes: MAX_JOURNAL_EVENT_PAYLOAD_BYTES,
+            max_journal_batch_bytes: budget,
+        }
+    }
