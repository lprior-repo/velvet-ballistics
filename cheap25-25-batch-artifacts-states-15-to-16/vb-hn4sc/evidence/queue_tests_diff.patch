+    /// Per AC-1.3: `JournalWriteBatch::append_event` and
+    /// `JournalWriterQueue::flush_batch` emit the IDENTICAL
+    /// `JournalBatchBytesExceeded { attempted, limit }` for the same
+    /// oversize event. This is the contract-parity lock.
+    ///
+    /// Setup: a `SlotWrittenEvent { value: Some(vec![0u8; 1_048_560]) }`
+    /// encodes to 1_048_630 bytes (60 header + 1_048_570 postcard
+    /// payload) for a small `RunId` (1..=127) — the 1-byte RunId
+    /// varint keeps the total inside `MAX_JOURNAL_EVENT_PAYLOAD_BYTES`.
+    /// Both paths are configured with the same effective limit
+    /// (1_048_576) so the emitted error matches exactly.
+    #[test]
+    fn journal_write_batch_and_journal_writer_queue_emit_identical_byte_budget_error() {
+        // 1. `JournalWriteBatch` path (default byte_limit = 1_048_576).
+        let (_temp, journal) = temp_journal();
+        let event = make_near_max_event(RunId::new(7), 0);
+        let mut batch = JournalWriteBatch::new(&journal);
+        let batch_result = batch.append_event(&event);
+        let batch_err = batch_result
+            .err()
+            .expect("JournalWriteBatch must reject oversize event");
+        let (batch_attempted, batch_limit) = match &batch_err {
+            JournalError::JournalBatchBytesExceeded { attempted, limit } => (*attempted, *limit),
+            other => panic!(
+                "JournalWriteBatch must return JournalBatchBytesExceeded, got {:?}",
+                other,
+            ),
+        };
+
+        // 2. `JournalWriterQueue` path with custom byte_budget = 1_048_576
+        //    (matching `JournalWriteBatch`'s default).
+        let queue = JournalWriterQueue::new(2, 2, limits_with_byte_budget(1_048_576))
+            .expect("queue creation should succeed");
+        let run = RunId::new(8);
+        queue
+            .enqueue_journaled(event.clone())
+            .expect("enqueue should succeed");
+        let queue_result = queue.flush_batch(&journal);
+        let queue_err = queue_result
+            .err()
+            .expect("JournalWriterQueue must reject oversize event");
+        let (queue_attempted, queue_limit) = match &queue_err {
+            JournalError::JournalBatchBytesExceeded { attempted, limit } => (*attempted, *limit),
+            other => panic!(
+                "JournalWriterQueue must return JournalBatchBytesExceeded, got {:?}",
+                other,
+            ),
+        };
+
+        // 3. Parity: same variant shape, same `attempted` (encoded
+        //    length), same `limit` (configured budget).
+        assert_eq!(
+            batch_attempted, NEAR_MAX_ENCODED_LEN,
+            "JournalWriteBatch attempted must equal the encoded length (1_048_630)",
+        );
+        assert_eq!(
+            queue_attempted, NEAR_MAX_ENCODED_LEN,
+            "JournalWriterQueue attempted must equal the encoded length (1_048_630)",
+        );
+        assert_eq!(
+            batch_attempted, queue_attempted,
+            "parity: both paths must report identical `attempted` for the same event",
+        );
+        assert_eq!(
+            batch_limit, 1_048_576,
+            "JournalWriteBatch limit must be its default (1_048_576)",
+        );
+        assert_eq!(
+            queue_limit, 1_048_576,
+            "JournalWriterQueue limit must mirror the configured byte_budget (1_048_576)",
+        );
+        assert_eq!(
+            batch_limit, queue_limit,
+            "parity: both paths must report identical `limit` for matching configs",
+        );
+        // Belt-and-suspenders: confirm both errors are the exact same
+        // variant (the test-writer contract requires this).
+        assert!(
+            matches!(batch_err, JournalError::JournalBatchBytesExceeded { .. })
+                && matches!(queue_err, JournalError::JournalBatchBytesExceeded { .. }),
+            "parity: both errors must be exactly JournalError::JournalBatchBytesExceeded",
+        );
+
+        // 4. Neither path commits a partial prefix. JournalWriteBatch's
+        //    append never inserted; JournalWriterQueue's flush returned
+        //    Err before any owned_batch.commit().
+        let events = journal.events_for_run(run).expect("replay should succeed");
+        assert!(
+            events.is_empty(),
+            "durable store must be empty after parity-test rejections, got {} events",
+            events.len(),
+        );
+    }
