+    /// that need to group multiple max-size events in a single
+    /// commit must raise this value; the contract forbids
+    /// raising `max_journal_batch_bytes` past `u64::MAX` (the gate
+    /// treats `u64::MAX` as "do not enforce").
+    pub max_journal_batch_bytes: u64,
 }
 
 impl StorageLimits {
     /// Default storage limits.
+    ///
+    /// `max_journal_batch_bytes` is set to
+    /// `DEFAULT_JOURNAL_BATCH_BYTE_LIMIT + 60` (1_048_636 bytes) where
+    /// the literal `60` mirrors [`crate::constants::RECORD_HEADER_BYTES`]
+    /// (the 60-byte record header). `RECORD_HEADER_BYTES` is declared
+    /// as a `usize` for ergonomic slicing and cannot be used directly
+    /// in a const-evaluated `u64` arithmetic expression without
