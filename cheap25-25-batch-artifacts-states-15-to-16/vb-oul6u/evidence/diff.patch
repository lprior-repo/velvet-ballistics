       21: /// Lossless conversion of a `u32` integer to its exact `f32` representation.
       22: ///
       23: /// `From<u32> for f32` is NOT implemented by the Rust standard library
       24: /// (only `From<u8>`, `From<u16>`, `From<i8>`, `From<i16>` exist for `f32`).
       25: /// For values in `[0, 2^24)` — which includes the full RA-003 trace-ring
       26: /// domain (`cap <= 2^20`, `len <= cap`) — the IEEE-754 single-precision
       27: /// encoding fits the integer exactly, so this helper produces a result
       28: /// bit-identical to `(n as f32)` without using an `as`-cast and without
       29: /// tripping `clippy::as_conversions`. All integer arithmetic uses
       30: /// `u32::checked_*` / `u32::saturating_*` so `clippy::arithmetic_side_effects`
       31: /// is also satisfied.
       32: fn u32_to_f32_exact(n: u32) -> f32 {
       33:     if n == 0 {
       34:         return 0.0_f32;
       35:     }
       36:     // `e = floor(log2(n))`. For n in [1, 2^32), `leading_zeros` is in [0, 31],
       37:     // so `e` is in [0, 31]. The `31 - ...` formula is the bit-width (32) minus
       38:     // 1 (for the implicit leading one) minus `leading_zeros`.
       39:     let e = u32::checked_sub(31, n.leading_zeros()).unwrap_or(0);
       40:     let biased_exp = u32::saturating_add(e, 127);
       41:     let power = 1_u32.checked_shl(e).unwrap_or(1);
       42:     let mantissa = u32::checked_sub(n, power)
       43:         .unwrap_or(0)
       44:         .checked_shl(23_u32.saturating_sub(e))
       45:         .unwrap_or(0);
       46:     f32::from_bits((biased_exp << 23) | mantissa)
       47: }
